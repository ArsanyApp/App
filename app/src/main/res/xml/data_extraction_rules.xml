<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep license data out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="license_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="license_state.xml" />
    </device-transfer>
</data-extraction-rules>
