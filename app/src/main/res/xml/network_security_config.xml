<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. 10.0.2.2 is the Android emulator's alias for the host computer and is used solely by
     the automated emulator tests; the app additionally refuses http:// unless built for those tests. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
